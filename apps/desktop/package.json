{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Elegant Stack desktop shell built with Electron",
  "author": "Elegant Stack",
  "repository": "https://github.com/markbang/fullstack",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "lint": "biome check .",
    "check-types": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/uno-config": "workspace:*",
    "@types/node": "^26.5.1",
    "@unocss/vite": "^66.10.5",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
