{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.omx",
      "!**/.source",
      "!**/.tanstack",
      "!**/.turbo",
      "!**/.nitro",
      "!**/.output",
      "!**/dist",
      "!**/drizzle",
      "!apps/desktop/out",
      "!**/*.db",
      "!**/*.db-shm",
      "!**/*.db-wal",
      "!**/routeTree.gen.ts",
      "!**/__uno.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
