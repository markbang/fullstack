{
  "name": "fullstack-template",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo check-types",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run test && bun run build",
    "commitlint": "commitlint --edit",
    "knip": "knip",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:web": "turbo dev --filter=web",
    "dev:docs": "turbo dev --filter=docs",
    "dev:desktop": "turbo dev --filter=desktop",
    "dev:api": "turbo dev --filter=api",
    "db:generate": "turbo db:generate --filter=api",
    "db:migrate": "turbo db:migrate --filter=api",
    "db:studio": "turbo db:studio --filter=api"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "knip": "^6.37.0",
    "turbo": "^2.9.6"
  }
}
